VITE_API_BASE_URL=http://localhost:8000

# Optional: only used by Capacitor CLI when set in the shell before `cap sync`.
# It lets the Android shell load the hosted web app instead of bundled assets.
# Hosted frontend mode should use https://. For trusted local http:// debugging,
# set CAP_ALLOW_CLEAR_TEXT=true in the shell before `cap sync`.
# CAP_SERVER_URL=https://your-frontend-domain.example
# CAP_ALLOW_CLEAR_TEXT=false
